# =============================================================================
# Production env template — Rcare Plus (Supabase self-hosted)
# Copy -> env.prod, fill REPLACE_ME values. NEVER commit the filled file.
# Values are split by WHERE they go; see docs/deploy-self-hosted.md.
# Không viết comment cùng dòng với giá trị (VAR=x # ...).
# =============================================================================


# =============================================================================
# [1] FRONTEND — environment của container FE (Portainer → Env), đọc lúc container start
# docker/env-config.sh ghi các VITE_* thành /env-config.js (window.__ENV__).
# Đổi giá trị => chỉ cần recreate container, KHÔNG cần build lại image.
# Mọi giá trị ở đây đều PUBLIC trên trình duyệt — không đặt secret server vào đây.
# =============================================================================
VITE_SUPABASE_URL=https://supabase.example.org
VITE_SUPABASE_ANON_KEY=REPLACE_ME
# Optional — defaults to ${VITE_SUPABASE_URL}/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=
VITE_SITE_URL=https://app.example.org
VITE_STT_API_URL=https://stt.example.org
VITE_OCR_SERVICE_URL=https://ocr.example.org
# Optional
VITE_OCR_CCCD_URL=
# Tạo: openssl rand -base64 32 (lưu ý: nằm trong bundle FE, không phải secret thật sự)
VITE_ENCRYPTION_SECRET_KEY=REPLACE_ME


# =============================================================================
# [2] SUPABASE IMAGE (rcare-supabase) — environment của service `functions`
# trong stack Supabase. Image = Edge Functions + migrations; mỗi lần container
# start sẽ tự chạy migration mới và nạp function mới.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
# thường đã có sẵn trong docker-compose của stack; chỉ đặt nếu compose chưa có.
# =============================================================================
# auto = chạy migration mới khi container start (mặc định)
# baseline = chỉ đánh dấu đã chạy, KHÔNG chạy SQL (DB đã migrate tay từ trước, dùng 1 lần)
# skip = không đụng DB
MIGRATE=auto
# Optional — gateway mà container db gọi tới cho cron (mặc định = SUPABASE_URL)
CRON_FUNCTIONS_BASE_URL=

# Link trong email trỏ về app (phải = VITE_SITE_URL)
SITE_URL=https://app.example.org

# SMTP (_shared/smtp.ts). Gmail: dùng App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM_NAME=Rcare Plus

# PHẢI giống hệt GOTRUE_HOOK_SEND_EMAIL_SECRETS ở mục [3].
# Tạo: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME

# GoTrue gọi hook auth-send-email không kèm JWT → tắt kiểm tra JWT toàn cục.
VERIFY_JWT=false

# Ký token tạm signup / reset password. Tạo mỗi cái: openssl rand -base64 32
TEMP_TOKEN_SECRET=REPLACE_ME
RESET_TOKEN_SECRET=REPLACE_ME

# Redis dùng chung giữa các function (khóa OTP, đếm sai, context email).
# Bỏ trống => khóa OTP KHÔNG có tác dụng trên production.
UPSTASH_REDIS_REST_URL=REPLACE_ME
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# Optional — cho phép gọi scan-pre-consult-reminders bằng header x-cron-secret
CRON_SECRET=


# =============================================================================
# [3] GOTRUE — environment của service `auth` (image gốc của Supabase, không build lại)
# Host trong GOTRUE_HOOK_SEND_EMAIL_URI phải là gateway của stack:
# `kong` (stack cũ) hoặc `api-gw` (stack mới) — xem SUPABASE_URL của service functions.
# =============================================================================
GOTRUE_SITE_URL=https://app.example.org
# Phân cách bằng dấu phẩy, không khoảng trắng
GOTRUE_URI_ALLOW_LIST=https://app.example.org,https://app.example.org/auth/callback,https://app.example.org/auth/set-password
API_EXTERNAL_URL=https://supabase.example.org

GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_SMS_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_LENGTH=6
GOTRUE_MAILER_OTP_EXP=86400
GOTRUE_JWT_EXP=3600
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_RATE_LIMIT_EMAIL_SENT=100

GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_ENABLED=true
GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_URI=pg-functions://postgres/public/custom_access_token_hook

GOTRUE_HOOK_SEND_EMAIL_ENABLED=true
GOTRUE_HOOK_SEND_EMAIL_URI=http://kong:8000/functions/v1/auth-send-email
GOTRUE_HOOK_SEND_EMAIL_SECRETS=v1,whsec_REPLACE_ME
