# =============================================================================
# Edge Functions (container `functions`) — các biến cần cho luồng Auth / OTP
# Self-hosted không có `supabase secrets set`: truyền vào environment của
# service `functions` rồi recreate container.
# Không viết comment cùng dòng với giá trị.
# =============================================================================

# Bắt buộc = GOTRUE_HOOK_SEND_EMAIL_SECRETS trong auth.env (nếu thiếu, auth-send-email
# sẽ dùng secret dummy công khai trong repo → GoTrue ký bằng secret khác → gửi mail lỗi 401)
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME

# Hook gọi từ GoTrue KHÔNG kèm JWT. Nếu edge-runtime bật kiểm tra JWT toàn cục,
# auth-send-email bị chặn 401 → không gửi được email OTP/invite/recovery.
# CẢNH BÁO: false áp dụng cho MỌI function. notify-appointment-cancelled và
# notify-pre-consult-reminder hiện chỉ dựa vào verify_jwt của platform, không tự
# kiểm tra người gọi → cần thêm kiểm tra trong code trước khi để false trên production.
VERIFY_JWT=false

# Link trong email trỏ về app
SITE_URL=https://healthcare-system-ns.vercel.app

# SMTP gửi email OTP / invite / recovery (_shared/smtp.ts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM_NAME=Rcare Plus

# Ký token tạm cho signup / reset password (_shared/temp-token.ts, _shared/reset-token.ts).
# Self-hosted không có SUPABASE_JWT_SECRET → phải đặt riêng. Tạo: openssl rand -base64 32
TEMP_TOKEN_SECRET=REPLACE_ME
RESET_TOKEN_SECRET=REPLACE_ME

# Khoá OTP / đếm số lần sai (_shared/redis.ts)
UPSTASH_REDIS_REST_URL=REPLACE_ME
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME
