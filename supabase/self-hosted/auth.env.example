# =============================================================================
# GoTrue (container `auth`) — Supabase self-hosted
# Thay cho các trang Dashboard → Authentication (Providers, OTP, URL, Hooks,
# Email Templates) mà Studio self-hosted không có.
# Nguồn: mục [auth] trong supabase/config.toml (file đó chỉ dùng khi chạy local).
#
# Cách dùng: truyền các biến này vào environment của service `auth`
# (vd. env_file), rồi recreate container `auth`.
# Không viết comment cùng dòng với giá trị (VAR=x # ...) — một số trình đọc
# env sẽ coi comment là một phần giá trị.
# =============================================================================

# --- URL Configuration -------------------------------------------------------
# Site URL: link mặc định trong email + redirect sau khi xác nhận
GOTRUE_SITE_URL=https://healthcare-system-ns.vercel.app
# Redirect URLs được phép (phân cách bằng dấu phẩy, không khoảng trắng)
GOTRUE_URI_ALLOW_LIST=https://healthcare-system-ns.vercel.app,https://healthcare-system-ns.vercel.app/auth/callback,https://healthcare-system-ns.vercel.app/auth/set-password
# URL public của Supabase API (dùng trong link /auth/v1/verify)
API_EXTERNAL_URL=https://supabase.hivns.org

# --- Sign In / Providers → Email ---------------------------------------------
# Allow new users to sign up
GOTRUE_DISABLE_SIGNUP=false
# Enable Email provider
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
# true = TẮT "Confirm email" (app dùng OTP 6 số qua signInWithOtp, không dùng link xác nhận)
GOTRUE_MAILER_AUTOCONFIRM=true
# Tắt đăng ký bằng số điện thoại (app không dùng). Compose mặc định bật phone +
# phone autoconfirm → ai cũng tạo được tài khoản đã xác nhận mà không cần OTP.
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_SMS_AUTOCONFIRM=false
# Email OTP Length
GOTRUE_MAILER_OTP_LENGTH=6
# Email OTP Expiration (giây) — 24h, áp dụng cho cả mã OTP và link invite/recovery
GOTRUE_MAILER_OTP_EXP=86400

# --- Sessions ----------------------------------------------------------------
GOTRUE_JWT_EXP=3600
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true

# --- Hooks → Custom Access Token ---------------------------------------------
# Thêm claim role/RBAC vào JWT. Hàm + GRANT cho supabase_auth_admin đã có trong
# migrations (20260225140000_user_profiles_portal_auth.sql, 20260630100000_customer_rbac.sql)
GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_ENABLED=true
GOTRUE_HOOK_CUSTOM_ACCESS_TOKEN_URI=pg-functions://postgres/public/custom_access_token_hook

# --- Hooks → Send Email ------------------------------------------------------
# Mọi email auth (OTP, invite, recovery) do Edge Function auth-send-email build
# template (supabase/functions/_shared/otp-email-html.ts) và gửi qua SMTP của app.
GOTRUE_HOOK_SEND_EMAIL_ENABLED=true
# Gọi nội bộ qua Kong trong mạng docker
GOTRUE_HOOK_SEND_EMAIL_URI=http://kong:8000/functions/v1/auth-send-email
# Tạo: echo "v1,whsec_$(openssl rand -base64 32)"
# PHẢI đặt cùng giá trị cho biến SEND_EMAIL_HOOK_SECRET của container `functions`.
GOTRUE_HOOK_SEND_EMAIL_SECRETS=v1,whsec_REPLACE_ME

# --- Rate limits -------------------------------------------------------------
# Số email auth tối đa mỗi giờ (mặc định GoTrue thấp, dễ chặn OTP khi nhiều người đăng ký)
GOTRUE_RATE_LIMIT_EMAIL_SENT=100

# --- Email Templates ---------------------------------------------------------
# Không cần khi đã bật Send Email hook ở trên (hook thay thế hoàn toàn template của GoTrue).
# Chỉ dùng nếu TẮT hook: GoTrue tải template qua URL, nên phải host 3 file
# supabase/templates/*.html ở một URL public.
# GOTRUE_MAILER_SUBJECTS_RECOVERY=Thiết lập mật khẩu — Rcare Plus
# GOTRUE_MAILER_SUBJECTS_INVITE=Mời tham gia Rcare Plus
# GOTRUE_MAILER_SUBJECTS_CONFIRMATION=Xác nhận email — Rcare Plus
# GOTRUE_MAILER_TEMPLATES_RECOVERY=https://<host>/templates/recovery.html
# GOTRUE_MAILER_TEMPLATES_INVITE=https://<host>/templates/invite.html
# GOTRUE_MAILER_TEMPLATES_CONFIRMATION=https://<host>/templates/confirmation.html

# --- Local dev (chỉ bật khi test FE local trỏ vào server này) ------------------
# Nối thêm vào GOTRUE_URI_ALLOW_LIST:
# http://localhost:5173,http://localhost:5173/auth/callback,http://localhost:5173/auth/set-password
